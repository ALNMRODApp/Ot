rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 320 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.theme is string && data.theme.size() > 0 && data.theme.size() <= 50;
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.template is string && data.template.size() > 0 && data.template.size() <= 50;
    }

    function isValidCodeFile(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.projectId is string && data.projectId.size() > 0 && data.projectId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.path is string && data.path.size() > 0 && data.path.size() <= 300 &&
             data.language is string && data.language.size() > 0 && data.language.size() <= 50 &&
             data.content is string && data.content.size() <= 1000000;
    }

    function isValidCustomAgent(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.systemInstruction is string && data.systemInstruction.size() <= 10000 &&
             data.category is string && data.category.size() <= 50 &&
             (!('apiType' in data) || (data.apiType is string && data.apiType.size() <= 50)) &&
             (!('endpointUrl' in data) || (data.endpointUrl is string && data.endpointUrl.size() <= 500)) &&
             (!('modelName' in data) || (data.modelName is string && data.modelName.size() <= 100)) &&
             (!('apiKey' in data) || (data.apiKey is string && data.apiKey.size() <= 500)) &&
             (!('isLocalhost' in data) || data.isLocalhost is bool);
    }

    function isValidAgentMessage(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             (data.role == 'user' || data.role == 'agent') &&
             data.content is string && data.content.size() <= 100000 &&
             (!('codeSnippet' in data) || data.codeSnippet == null || (data.codeSnippet is string && data.codeSnippet.size() <= 100000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       incoming().userId == userId &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'theme', 'updatedAt']);

      allow delete: if isOwner(userId);

      match /projects/{projectId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().userId == userId &&
                         incoming().id == projectId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidProject(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidProject(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'template', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      match /files/{fileId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(fileId) &&
                         incoming().userId == userId &&
                         incoming().id == fileId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCodeFile(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(fileId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCodeFile(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'path', 'language', 'content', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(fileId);
      }

      match /custom_agents/{agentId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(agentId) &&
                         incoming().userId == userId &&
                         incoming().id == agentId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCustomAgent(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(agentId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCustomAgent(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'systemInstruction', 'iconName', 'accentColorHex', 'category', 'apiType', 'endpointUrl', 'modelName', 'apiKey', 'isLocalhost', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(agentId);
      }

      match /agent_messages/{messageId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().userId == userId &&
                         incoming().id == messageId &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidAgentMessage(incoming());

        allow delete: if isOwner(userId) && isValidId(messageId);
        allow update: if false;
      }
    }
  }
}
